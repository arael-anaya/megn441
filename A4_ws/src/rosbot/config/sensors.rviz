Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: RobotModel
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Visual Enabled: true
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: LaserScan (filtered)
      Size (m): 0.05
      Style: Flat Squares
      Color: 255; 0; 0
      Value: true
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
    - Class: rviz_default_plugins/LaserScan
      Enabled: false
      Name: LaserScan (raw)
      Size (m): 0.03
      Style: Points
      Color: 0; 255; 0
      Value: false
      Topic:
        Value: /scan_raw
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
    - Class: rviz_default_plugins/Camera
      Enabled: true
      Name: Camera
      Image Rendering: background and overlay
      Overlay Alpha: 0.5
      Transport Hint: raw
      Zoom Factor: 1
      Value: true
      Topic:
        Value: /depth_cam/color/image_raw
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
    - Class: rviz_default_plugins/DepthCloud
      Enabled: true
      Name: DepthCloud
      Style: Flat Squares
      Color Transformer: RGB8
      Queue Size: 5
      Autocompute Intensity Bounds: true
      Occlusion Compensation:
        Enabled: false
        Value: 30
      Depth Map Topic: /depth_cam/depth/image_raw
      Depth Map Transport Hint: raw
      Color Image Topic: /depth_cam/color/image_raw
      Color Transport Hint: raw
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: false
      Name: Color Image
      Value: false
      Topic:
        Value: /depth_cam/color/image_raw
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
    - Class: rviz_default_plugins/Image
      Enabled: false
      Name: Depth Image
      Value: false
      Topic:
        Value: /depth_cam/depth/image_raw
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
    - Class: rviz_default_plugins/PointCloud2
      Enabled: false
      Name: Depth Points
      Size (m): 0.01
      Style: Points
      Color Transformer: RGB8
      Value: false
      Topic:
        Value: /depth_cam/depth/points
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_footprint
    Frame Rate: 30
  Name: root
  Tools: []
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 6
      Pitch: 1.0
      Yaw: 3.14
    Saved: ~
