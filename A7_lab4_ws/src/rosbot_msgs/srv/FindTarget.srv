# What to look for: "block" (a red block on the floor); "bucket" is added later
string kind
# True: look from where the arm is now instead of moving it to the look pose first, and make one attempt only
bool keep_arm
# True: never back the arm up for a wider view when nothing is seen
bool no_raise
---
bool found
# True if ik_node would accept the pick (or place) pose for it from where the arm is now
bool reachable
# Where the target is, in the arm frame (m, x forward from the joint 1 axis, y left), and its edge direction (rad)
float64 x
float64 y
float64 yaw
string message
